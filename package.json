{
  "name": "mac-ssh-client",
  "version": "0.2.3",
  "description": "Minimal MobaXterm-style SSH client: saved-host sidebar, tabbed terminals, and a live remote resource monitor.",
  "author": "Yuvaraj Mudaliar",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "icons:win": "electron scripts/make-win-icon.js",
    "site:publish": "node scripts/publish-site.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yuvim.macssh",
    "productName": "YuviXterm",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "preload/**",
      "renderer/**",
      "package.json",
      "!**/*.map",
      "!**/node_modules/cpu-features/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YuviXterm",
      "uninstallDisplayName": "YuviXterm"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
